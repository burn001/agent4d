{
  "name": "agent4d",
  "version": "0.1.1",
  "description": "Agent4D — your coding agents in 3D space + time. Unofficial, local, read-only viewer for Claude Code sessions: main agent, subagents, workflows, claude -p runs and background jobs as one live tree in the browser",
  "private": true,
  "license": "Apache-2.0",
  "author": "burn001 (Dr. Cho, Sangkyu)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burn001/agent4d.git"
  },
  "homepage": "https://github.com/burn001/agent4d#readme",
  "bugs": {
    "url": "https://github.com/burn001/agent4d/issues"
  },
  "keywords": [
    "claude-code",
    "agents",
    "visualization",
    "three.js",
    "sse",
    "developer-tools"
  ],
  "bin": {
    "agent4d": "bin/agent4d.mjs",
    "ccviz": "bin/ccviz.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/agent4d.mjs start",
    "server": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "test": "node --test server/test && node --test \"web/test/*.test.mjs\""
  }
}
